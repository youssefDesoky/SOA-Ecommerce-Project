# ===========================================
# Environment Configuration for Flask Services
# ===========================================
# Copy this file to .env and fill in your values
# NEVER commit .env to source control!

# ==================== DATABASE ====================
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=ecommerce_system

# ==================== SERVICE URLS ====================
CUSTOMER_SERVICE_URL=http://localhost:5004/api/customers
INVENTORY_SERVICE_URL=http://localhost:5002/api/inventory
ORDER_SERVICE_URL=http://localhost:5001/api/orders
PRICING_SERVICE_URL=http://localhost:5003/api/pricing
NOTIFICATION_SERVICE_URL=http://localhost:5005/api/notifications

# ==================== SERVICE PORTS ====================
CUSTOMER_SERVICE_PORT=5004
INVENTORY_SERVICE_PORT=5002
ORDER_SERVICE_PORT=5001
PRICING_SERVICE_PORT=5003
NOTIFICATION_SERVICE_PORT=5005

# ==================== EMAIL (SMTP) ====================
# For Gmail: Enable 2FA and create App Password at https://myaccount.google.com/apppasswords
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SENDER_EMAIL=your-email@gmail.com
SENDER_PASSWORD=your-app-password

# ==================== APP SETTINGS ====================
DEBUG=True
HOST=0.0.0.0
